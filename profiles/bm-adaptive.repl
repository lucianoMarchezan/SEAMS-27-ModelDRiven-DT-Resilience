model BELONGING bm-adaptive extends bm-controlled {
  refine Participating { 
    initial FullRole
    states FullRole, RestrictedRole
  }

  transition FullRole -> RestrictedRole restrictRole
  transition RestrictedRole -> FullRole restoreRole
  transition Participating -> PendingExit withdrawParticipation
  transition RestrictedRole -> PendingExit uncertaintyExceeded
}

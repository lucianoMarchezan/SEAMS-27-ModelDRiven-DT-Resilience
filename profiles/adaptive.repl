// Standalone declaration avoids inheriting Controlled's different invitation guard.
// The belonging model still inherits the Controlled structure.
Reliability adaptive {
    Health: hm
    Belonging: bm-adaptive

    when Belonging::joinSos {
        require Health in {Ideal, Defective, Faulty, Erroneous, Malfunctioning, Degraded}
    }

    when Belonging::stopActive {
        require Health = Failed
    }

    when Belonging::joinRequest {
        require Health = Ideal
    }

    // Matches itemis CREATE: invitations require non-Ideal health.
    when Belonging::joinInvitation {
        require Health in {Defective, Faulty, Erroneous, Malfunctioning, Degraded, Failed}
    }

    when Belonging::restrictRole {
        require Health in {Erroneous, Malfunctioning}
    }

    when Belonging::restoreRole {
        require Health = Ideal
    }

    if Health::thresholdViolated and Health = Failed and Belonging = Active {
        trigger Belonging::stopActive
    }

    if Health::thresholdViolated and Health = Failed and Belonging = Passive {
        trigger Belonging::leaveSos
    }

    // stabilizationComplete maps to the generated three-second entry timer.
    // FullRole is the default; these entry rules represent the health choice.
    if Belonging::stabilizationComplete and Health in {Erroneous, Malfunctioning} {
        trigger Belonging::restrictRole
    }

    if Belonging::stabilizationComplete and Health in {Degraded, Faulty} {
        trigger Belonging::withdrawParticipation
    }

    // Re-entry after exit denial evaluates the same health choice.
    if Belonging::exitDenied and Health in {Erroneous, Malfunctioning} {
        trigger Belonging::restrictRole
    }

    if Belonging::exitDenied and Health in {Degraded, Faulty} {
        trigger Belonging::withdrawParticipation
    }

    // Changes during participation follow health events, not general guards.
    if Health::faultExercised and Health = Erroneous and Belonging = FullRole {
        trigger Belonging::restrictRole
    }

    if Health::recovery and Health = Ideal and Belonging = RestrictedRole {
        trigger Belonging::restoreRole
    }

    if Health::impactObserved and Health = Degraded and Belonging = Participating {
        trigger Belonging::withdrawParticipation
    }
}

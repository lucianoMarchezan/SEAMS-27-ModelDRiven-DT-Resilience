model BELONGING bm-controlled extends bm-proactive {
  refine Passive {
    initial Available
    states Available, Negotiating
  }

  transition Available -> Negotiating joinRequest
  transition Available -> Negotiating joinInvitation
  transition Negotiating -> Available admissionRejected
  override transition Negotiating -> bm::Active bm::joinConstellation
  transition PendingExit -> Participating exitDenied
}

Health model hm {
    health-state Ideal
    health-state Defective
    health-state Faulty
    health-state Erroneous
    health-state Malfunctioning
    health-state Degraded
    health-state Failed

    transition Ideal -> Defective: component deviation
    transition Defective -> Faulty: defect activated
    transition Faulty -> Erroneous: erroneous behavior detected
    transition Erroneous -> Malfunctioning: malfunction detected
    transition Malfunctioning -> Degraded: degradation detected
    transition Degraded -> Failed: failure confirmed
}
grammar org.example.reliability.Reliability with org.eclipse.xtext.common.Terminals

generate reliability "http://www.example.org/reliability/Reliability"

Model:
    elements+=Element*;

Element:
    HealthModel | BelongingModel | ReliabilityProfile;

QualifiedName:
    ID ('.' ID)*;

// ---------------- Health ----------------

HealthModel:
    'health' name=ID '{'
        (states+=HealthState | transitions+=HealthTransition)*
    '}';

HealthState:
    (initial?='initial')? 'state' name=ID;

HealthTransition:
    'transition' name=ID ':' source=[HealthState] '->' target=[HealthState];

// ---------------- Belonging ----------------

BelongingModel:
    'belonging' name=ID ('extends' parent=[BelongingModel])? '{'
        (states+=BState | refinements+=Refinement | transitions+=BTransition)*
    '}';

BState:
    (initial?='initial')? 'state' name=ID;

// adds substates (and their transitions) to a state inherited from an ancestor model
Refinement:
    'refine' target=[BState|QualifiedName] '{'
        (substates+=BState | transitions+=BTransition)+
    '}';

// 'override' replaces the inherited transition with the same id
BTransition:
    NewTransition | OverrideTransition;

NewTransition:
    'transition' name=ID ':'
        source=[BState|QualifiedName] '->' target=[BState|QualifiedName];

OverrideTransition:
    'override' overrides=[BTransition] ':'
        source=[BState|QualifiedName] '->' target=[BState|QualifiedName];

// ---------------- Reliability profile ----------------

ReliabilityProfile:
    'profile' name=ID ('extends' parent=[ReliabilityProfile])? '{'
        ('level' level=INT)?
        ('health' health=[HealthModel])?          // optional: inherited from parent
        'belonging' belonging=[BelongingModel]
        (rules+=ProfileRule | disables+=Disable)*
    '}';

ProfileRule:
    Trigger | Guard;

Trigger:
    (override?='override')? 'trigger' name=ID
        'on' healthTransition=[HealthTransition]
        'fire' fire+=[BTransition] (',' fire+=[BTransition])*;

Guard:
    (override?='override')? 'guard' name=ID
        'on' belongingTransition=[BTransition]
        'blocked_when' blocked+=[HealthState] (',' blocked+=[HealthState])*;

Disable:
    'disable' target=[ProfileRule];